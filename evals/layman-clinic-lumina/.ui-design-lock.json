    "--border-hairline": "oklch(18.0% 0.022 155.0 / 0.11)",
    "--border-strong": "oklch(18.0% 0.022 155.0 / 0.22)",
    "--ease-spring": "cubic-bezier(0.16, 1, 0.3, 1)",
    "--ease-out-expo": "cubic-bezier(0.19, 1, 0.22, 1)"
