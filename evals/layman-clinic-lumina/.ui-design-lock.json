        "navigation",
        "card",
        "table"
      ],
      "props": "/** 'compact' for hero quick-booking (Screen 1) or 'month' for full patient scheduling (Screen 2..N) */ variant?: 'compact' | 'month'; days: CalendarDaySlot[]; selectedDate: string; selectedSlot: string; doctorName?: string; onSelectDate: (dateIso: string) => void; onSelectSlot: (slot: string) => void;",
      "description": "Reusable LuminaCalendar primitive"
    },
    {
      "name": "LuminaNavPill",
      "path": "components/ui/LuminaNavPill.tsx",
      "tags": [
        "calendar",
        "navigation",
        "card"
      ],
      "props": "activeRoute: 'home' | 'portal' | 'protocols'; patientName?: string; ctaLabel?: string;",
      "description": "Reusable LuminaNavPill primitive"
    },
    {
      "name": "LuminaSegmentedPill",
      "path": "components/ui/LuminaSegmentedPill.tsx",
      "tags": [
        "segmented-control",
        "card",
        "table"
      ],
      "props": "options: SegmentedOption[]; activeId: string; onChange: (id: string) => void;",
      "description": "Reusable LuminaSegmentedPill primitive"
    }
  ]
